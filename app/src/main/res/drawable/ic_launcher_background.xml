            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="90" android:centerY="94"
                android:gradientRadius="58" android:tileMode="clamp">
                <item android:offset="0.0" android:color="#59415FFF" />
                <item android:offset="1.0" android:color="#00415FFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
