<?xml version="1.0" encoding="utf-8"?><!-- 「影中影」图标背景层（108dp 全幅，会被启动器裁成圆/方/球形）。

     液态玻璃的"液"来自底色本身：一块被侧光照到的暗房。VectorDrawable 没有高斯模糊，
     所以这里一律用渐变叠出体积，而不是画模糊：
       · 1 层对角线性底（左上亮、右下沉），定住光源方向（与前景所有高光同向）
       · 2 层径向辉光（左上冷白、右下品牌蓝 #415FFF），提供"光在介质里走了一段"的错觉
       · 1 层径向暗角压回中心，避免小尺寸时整块发灰 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1 · 对角底色 -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14" android:startY="8"
                android:endX="94" android:endY="100">
                <item android:offset="0.0" android:color="#FF22384D" />
                <item android:offset="0.45" android:color="#FF152334" />
                <item android:offset="1.0" android:color="#FF070C12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2a · 左上冷白辉光（主光源） -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30" android:centerY="22"
                android:gradientRadius="72"
                android:tileMode="clamp">
                <item android:offset="0.0" android:color="#3CC9E4F5" />
                <item android:offset="0.5" android:color="#159FC4DE" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2b · 右下品牌蓝辉光（对侧补色，玻璃里偏蓝是折射的结果） -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="86" android:centerY="92"
                android:gradientRadius="58"
                android:tileMode="clamp">
                <item android:offset="0.0" android:color="#3D415FFF" />
                <item android:offset="0.55" android:color="#1A3C63D8" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3 · 中心暗角：把注意力收回中岛，防止 26px 时糊成一片灰 -->
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="56"
                android:gradientRadius="66"
                android:tileMode="clamp">
                <item android:offset="0.0" android:color="#00000000" />
                <item android:offset="0.62" android:color="#00000000" />
                <item android:offset="1.0" android:color="#73040A11" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
