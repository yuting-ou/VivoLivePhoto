<?xml version="1.0" encoding="utf-8"?><!-- 「影中影」图标前景（108dp 画布，内容收在中央安全区内）。

     材质：液态玻璃 · **亮面版**。与暗面版的区别不是把底色调亮，而是三处逻辑必须跟着翻：
       1. 播放三角**不能再是挖空**——白纸上挖个洞等于什么也没画。改成实心品牌蓝渐变，
          它同时承担「图标唯一的动作」与「整张图最强的对比锚点」两件事
       2. 玻璃的边**必须比两侧都暗**（折射把表面折离纸面 ⇒ 一条冷灰线），
          只在左上与右下两端各捞一道白。暗面版那套"边比面亮"在亮底上完全立不住
       3. 亮底**不能压暗角**，多一分就脏；卡片与纸面的分离改由**投影**负责
     其余四条判据不变：斜向扫光是决定性的那一条；附加光必须复用 body 的 pathData
     否则溢出边界糊成脏斑；光向必须与底色高光同向。

     几何基准沿用 v1.7.14 批准的方案（只换材质与配色，概念与构图不动）：
       · 前卡 48×32（3:2 照片比例），外角 r6、内角 r4.5，环宽 2dp
       · 后卡同尺寸、右移上移各 5dp、旋转 -6°，做成玻璃片（淡冷灰实心 + 细冷灰边）
       · 三角包围盒中心 x≈53.75，比卡片中心 52 右移 1.5dp：右指三角视觉重心偏左

     尺寸约束（实测纠正过一次，别按 108 想当然）：AdaptiveIconDrawable 把图层**放大 1.5 倍**
     绘制，只有图层坐标 18..90 那 72dp 会显示出来，其余被裁。本图最外元素是后卡的
     旋转角（图层 x≈81.5、y≈34），都在 18..90 内；圆遮罩下最远的角点距中心 ≈29.7 < 36。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 0 · 投影：必须**收紧**——铺太开会把卡外一圈纸面一起压暗，反而吃掉玻璃与纸面的
         调子差（第一版 scale 1.06/1.14 + radius 26 时 paper 从 238.7 掉到 217.1，差值归零） -->
    <group
        android:pivotX="52"
        android:pivotY="58"
        android:scaleX="1.02"
        android:scaleY="1.06"
        android:translateY="2.2">
        <path android:pathData="M34,42 H70 A6,6 0 0 1 76,48 V68 A6,6 0 0 1 70,74 H34 A6,6 0 0 1 28,68 V48 A6,6 0 0 1 34,42 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="52" android:centerY="58"
                    android:gradientRadius="21"
                    android:tileMode="clamp">
                    <item android:offset="0.0" android:color="#3333506E" />
                    <item android:offset="0.55" android:color="#1A33506E" />
                    <item android:offset="1.0" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- 后卡：一块垫在后面的玻璃片，只露右上角 -->
    <group
        android:rotation="-6"
        android:pivotX="57"
        android:pivotY="53">
        <path
            android:fillColor="#1F8FA6BE"
            android:pathData="M37.5,37 H76.5 A4.5,4.5 0 0 1 81,41.5 V64.5 A4.5,4.5 0 0 1 76.5,69 H37.5 A4.5,4.5 0 0 1 33,64.5 V41.5 A4.5,4.5 0 0 1 37.5,37 Z" />
        <path
            android:strokeColor="#8FA8BDD4"
            android:strokeWidth="2.6"
            android:fillColor="#00000000"
            android:pathData="M37.5,37 H76.5 A4.5,4.5 0 0 1 81,41.5 V64.5 A4.5,4.5 0 0 1 76.5,69 H37.5 A4.5,4.5 0 0 1 33,64.5 V41.5 A4.5,4.5 0 0 1 37.5,37 Z" />
    </group>

    <!-- 前卡玻璃的"面"：比纸面沉一档。亮底上轮廓**只能**靠这个调子差来带——
         实测 2dp 边线在 48px 下被抗锯齿抹平（edge≈240.9 vs paper≈238.7），带不动形 -->
    <path
        android:pathData="M34.5,44 H69.5 A4.5,4.5 0 0 1 74,48.5 V67.5 A4.5,4.5 0 0 1 69.5,72 H34.5 A4.5,4.5 0 0 1 30,67.5 V48.5 A4.5,4.5 0 0 1 34.5,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="52" android:startY="44"
                android:endX="52" android:endY="72">
                <item android:offset="0.0" android:color="#FFDCE8F5" />
                <item android:offset="0.18" android:color="#FFC9D8E9" />
                <item android:offset="0.5" android:color="#FFBCCCE0" />
                <item android:offset="0.82" android:color="#FFC4D3E5" />
                <item android:offset="1.0" android:color="#FFB2C4DA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 斜向扫光：裁在面里 -->
    <path
        android:pathData="M34.5,44 H69.5 A4.5,4.5 0 0 1 74,48.5 V67.5 A4.5,4.5 0 0 1 69.5,72 H34.5 A4.5,4.5 0 0 1 30,67.5 V48.5 A4.5,4.5 0 0 1 34.5,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28" android:startY="42"
                android:endX="78" android:endY="76">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.26" android:color="#00FFFFFF" />
                <item android:offset="0.44" android:color="#4DD9EEFB" />
                <item android:offset="0.53" android:color="#80FFFFFF" />
                <item android:offset="0.63" android:color="#1AE8F4FF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底角聚光：同样复用面的 pathData -->
    <path
        android:pathData="M34.5,44 H69.5 A4.5,4.5 0 0 1 74,48.5 V67.5 A4.5,4.5 0 0 1 69.5,72 H34.5 A4.5,4.5 0 0 1 30,67.5 V48.5 A4.5,4.5 0 0 1 34.5,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="63" android:centerY="68"
                android:gradientRadius="20"
                android:tileMode="clamp">
                <item android:offset="0.0" android:color="#40FFFFFF" />
                <item android:offset="0.5" android:color="#1ABFD4E8" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 前卡玻璃的"边"：冷灰线（比纸面与卡面都沉）+ 两端各一道白。
         这一层只服务大尺寸观感，小尺寸的形由上面的调子差负责 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M34,42 H70 A6,6 0 0 1 76,48 V68 A6,6 0 0 1 70,74 H34 A6,6 0 0 1 28,68 V48 A6,6 0 0 1 34,42 Z
                          M34.5,44 H69.5 A4.5,4.5 0 0 1 74,48.5 V67.5 A4.5,4.5 0 0 1 69.5,72 H34.5 A4.5,4.5 0 0 1 30,67.5 V48.5 A4.5,4.5 0 0 1 34.5,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28" android:startY="42"
                android:endX="76" android:endY="74">
                <item android:offset="0.0" android:color="#FFFDFEFF" />
                <item android:offset="0.16" android:color="#FFCAD8E7" />
                <item android:offset="0.45" android:color="#FFA8BBD0" />
                <item android:offset="0.72" android:color="#FFB4C5D8" />
                <item android:offset="1.0" android:color="#FFF8FBFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶边镜面高光 -->
    <path android:pathData="M37.6,45.4 H64.4 A0.6,0.6 0 0 1 65,46 A0.6,0.6 0 0 1 64.4,46.6 H37.6 A0.6,0.6 0 0 1 37,46 A0.6,0.6 0 0 1 37.6,45.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37" android:startY="46"
                android:endX="65" android:endY="46">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.36" android:color="#F7FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底边折射亮带：偏右亮 -->
    <path android:pathData="M39.6,69.9 H66.4 A0.5,0.5 0 0 1 66.9,70.4 A0.5,0.5 0 0 1 66.4,70.9 H39.6 A0.5,0.5 0 0 1 39.1,70.4 A0.5,0.5 0 0 1 39.6,69.9 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="39" android:startY="70.4"
                android:endX="67" android:endY="70.4">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.55" android:color="#80FFFFFF" />
                <item android:offset="1.0" android:color="#CCFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 播放形：亮底上不能再挖空，改实心品牌蓝渐变，同时是整张图最强的对比锚点 -->
    <path android:pathData="M49.3,51.8 L58.3,57 Q60,58 58.3,59 L49.3,64.2 Q47,65.6 47,63 L47,53 Q47,50.4 49.3,51.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="47" android:startY="51"
                android:endX="60" android:endY="65.5">
                <item android:offset="0.0" android:color="#FF5A78FF" />
                <item android:offset="0.55" android:color="#FF415FFF" />
                <item android:offset="1.0" android:color="#FF2A41B8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
