<?xml version="1.0" encoding="utf-8"?><!-- 候选 E4 前景：对齐苹果 Liquid Glass 语言。
     与 E3 的区别：把"乳白磨砂"换成"清透"——白雾降到 10%–25%，玻璃变成透明介质，
     靠四件苹果签名细节立住：① 贴顶的脆亮 rim 光（细白线 + 柔光双层）；
     ② 底缘内侧一道厚度暗线（玻璃的"壁"）；③ 玻璃身里一层极淡品牌蓝（对透过的底色做增饱和）；
     ④ 卡片下的悬浮软阴影。形状推到正胶囊（外 r16 / 内 r14，直边 4dp） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:rotation="-6" android:pivotX="57" android:pivotY="53">
        <path android:fillColor="#1F9FB5D0"
            android:pathData="M45.5,37 H68.5 A8,8 0 0 1 76.5,45 V61 A8,8 0 0 1 68.5,69 H45.5 A8,8 0 0 1 37.5,61 V45 A8,8 0 0 1 45.5,37 Z" />
        <path android:strokeColor="#99D9EBFA" android:strokeWidth="2.8" android:fillColor="#00000000"
            android:pathData="M45.5,37 H68.5 A8,8 0 0 1 76.5,45 V61 A8,8 0 0 1 68.5,69 H45.5 A8,8 0 0 1 37.5,61 V45 A8,8 0 0 1 45.5,37 Z" />
    </group>

    <!-- 悬浮软阴影：玻璃片浮在后卡之上 -->
    <path android:pathData="M40,74 A14,6 0 1 0 68,74 A14,6 0 1 0 40,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="74"
                android:gradientRadius="15" android:tileMode="clamp">
                <item android:offset="0.0" android:color="#33101828" />
                <item android:offset="1.0" android:color="#00101828" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 玻璃身（正胶囊）：清透基底 → 品牌蓝增饱和 → 底部厚度暗线，三层同形叠加 -->
    <path android:pathData="M42,44 H62 A14,14 0 0 1 62,72 H42 A14,14 0 0 1 42,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="32" android:startY="45"
                android:endX="72" android:endY="71">
                <item android:offset="0.0" android:color="#40FFFFFF" />
                <item android:offset="0.4" android:color="#26DCEAF6" />
                <item android:offset="0.7" android:color="#1ACFE2F2" />
                <item android:offset="1.0" android:color="#33E8F4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M42,44 H62 A14,14 0 0 1 62,72 H42 A14,14 0 0 1 42,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="32" android:startY="45"
                android:endX="72" android:endY="71">
                <item android:offset="0.0" android:color="#33415FFF" />
                <item android:offset="0.55" android:color="#26415FFF" />
                <item android:offset="1.0" android:color="#1A2A41B8" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M42,44 H62 A14,14 0 0 1 62,72 H42 A14,14 0 0 1 42,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="52" android:startY="44"
                android:endX="52" android:endY="72">
                <item android:offset="0.0" android:color="#00000000" />
                <item android:offset="0.72" android:color="#00000000" />
                <item android:offset="1.0" android:color="#2E101E38" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 残余微光带（苹果式高光都很收敛，强度减半） -->
    <path android:pathData="M30,52 C42,44 58,64 74,54 L74,60 C58,70 42,50 30,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="30" android:startY="55"
                android:endX="74" android:endY="55">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.5" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 播放形：实心品牌蓝 -->
    <path android:pathData="M49.3,51.8 L58.3,57 Q60,58 58.3,59 L49.3,64.2 Q47,65.6 47,63 L47,53 Q47,50.4 49.3,51.8 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="47" android:startY="51"
                android:endX="60" android:endY="65.5">
                <item android:offset="0.0" android:color="#FF5A78FF" />
                <item android:offset="0.55" android:color="#FF415FFF" />
                <item android:offset="1.0" android:color="#FF2A41B8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 边：外 r16 / 内 r14 正胶囊环，双端亮 -->
    <path android:fillType="evenOdd"
        android:pathData="M42,42 H62 A16,16 0 0 1 62,74 H42 A16,16 0 0 1 42,42 Z
                          M42,44 H62 A14,14 0 0 1 62,72 H42 A14,14 0 0 1 42,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="28" android:startY="42"
                android:endX="76" android:endY="74">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.3" android:color="#B8E2F0FA" />
                <item android:offset="0.5" android:color="#59D5E8F6" />
                <item android:offset="0.7" android:color="#B8E2F0FA" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ① 贴顶脆亮 rim 光：细白线 + 柔光双层，沿顶部轮廓走 -->
    <path android:strokeColor="#40FFFFFF" android:strokeWidth="3" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M37,49 A28,28 0 0 1 67,49" />
    <path android:strokeColor="#E6FFFFFF" android:strokeWidth="1.3" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M37,49 A28,28 0 0 1 67,49" />

    <!-- ② 底缘内侧厚度暗线 -->
    <path android:strokeColor="#26101828" android:strokeWidth="1.2" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M39,67 A28,28 0 0 0 65,67" />

    <!-- 沉底光池 -->
    <path android:pathData="M37,68 A15,4.5 0 1 0 67,68 A15,4.5 0 1 0 37,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="52" android:centerY="68"
                android:gradientRadius="15" android:tileMode="clamp">
                <item android:offset="0.0" android:color="#33FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
