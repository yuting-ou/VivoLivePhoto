<?xml version="1.0" encoding="utf-8"?>
<!-- 「影中影」图标前景（108dp 画布，内容收在中央 66dp 安全圆内）。

     几何全部由一个基准推出，不是各处手写：
       · 前卡 48×32（3:2 照片比例），圆角 6dp
       · 后卡同一尺寸，向右上方各偏 5dp、旋转 -6°，**只描边**（3dp、55% 暖白）
         ⇒ 露出的正是右上角两条边，读作「后面还有一张」，而不是一坨灰
       · 播放三角**挖空**（与前卡同一条 path + evenOdd）透出底色
         ⇒ 图标只剩「暗房里的一帧」这一个动作；后卡改描边的原因也在此：
           若它实心铺在前卡底下，挖空处会透出那片灰而不是深色底（第一版就踩了）
       · 三角圆角 ≈ 卡片一半；其包围盒中心 (53.5,58) 相对卡片中心右移 1.5dp，
         因为右指三角形的视觉重心偏左，按边框居中会看起来左坠 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 后卡：只露右上角两条边的描边 -->
    <group
        android:rotation="-6"
        android:pivotX="57"
        android:pivotY="53">
        <path
            android:strokeColor="#8CF5F1E8"
            android:strokeWidth="3"
            android:fillColor="#00000000"
            android:pathData="M37.5,37 H76.5 A4.5,4.5 0 0 1 81,41.5 V64.5 A4.5,4.5 0 0 1 76.5,69 H37.5 A4.5,4.5 0 0 1 33,64.5 V41.5 A4.5,4.5 0 0 1 37.5,37 Z" />
    </group>

    <!-- 前卡 + 挖空的播放三角 -->
    <path
        android:fillColor="#F5F1E8"
        android:fillType="evenOdd"
        android:pathData="M34,42 H70 A6,6 0 0 1 76,48 V68 A6,6 0 0 1 70,74 H34 A6,6 0 0 1 28,68 V48 A6,6 0 0 1 34,42 Z
                          M50,52.9 L58.2,57.6 Q59.5,58 58.2,58.4 L50,63.1 Q47.5,64.5 47.5,61.9 L47.5,54.1 Q47.5,51.5 50,52.9 Z" />
</vector>
