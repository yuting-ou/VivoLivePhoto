<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 以下 Auto Backup 规则（minSdk 34 实际不生效，保持与 data_extraction_rules 一致）。
     排除设备相关的敏感记录，保留用户偏好。 -->
<full-backup-content>
    <exclude domain="file" path="convert_queue.json"/>
    <exclude domain="file" path="convert_queue.json.tmp"/>
    <exclude domain="file" path="picker_cache.json"/>
    <exclude domain="file" path="picker_cache.json.tmp"/>
    <exclude domain="file" path="batch_log.json"/>
    <exclude domain="file" path="batch_log.json.tmp"/>
    <exclude domain="file" path="crash/"/>
</full-backup-content>